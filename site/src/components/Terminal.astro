---
interface Props {
  title?: string;
  class?: string;
}
const { title = 'opcode', class: klass = '' } = Astro.props;
---
<div class:list={['term overflow-hidden', klass]}>
  <div class="flex items-center gap-2 px-4 h-10 box-shadow-none border-b border-white/[0.145]">
    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
    <span class="mx-auto text-[11px] t-dim tracking-wider uppercase">{title}</span>
  </div>
  <div class="p-5 sm:p-6 text-[13px] leading-[1.8] overflow-x-auto">
    <slot />
  </div>
</div>
