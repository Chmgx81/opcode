---
interface Props {
  title?: string;
  class?: string;
}
const { title = 'opcode', class: klass = '' } = Astro.props;
---
<div class:list={[
  'rounded-xl border border-line bg-panel shadow-[0_24px_70px_-30px_rgb(0_0_0/0.8)] overflow-hidden',
  klass,
]}>
  <div class="flex items-center gap-2 px-4 h-10 bg-raise border-b border-line">
    <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
    <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
    <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    <span class="mx-auto text-xs text-sub font-mono">{title}</span>
  </div>
  <div class="p-5 sm:p-6 font-mono text-[13px] sm:text-[13.5px] leading-[1.75] overflow-x-auto">
    <slot />
  </div>
</div>
